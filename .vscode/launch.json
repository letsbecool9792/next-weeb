{
    // Run the Django backend under the VS Code debugger.
    // Select the backend venv as the interpreter first (Python: Select Interpreter).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django backend",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/backend/manage.py",
            "args": ["runserver", "8000"],
            "cwd": "${workspaceFolder}/backend",
            "django": true,
            "autoStartBrowser": false
        }
    ]
}
