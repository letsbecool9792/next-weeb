# Copy to .env.development (local) and fill in. Production values go in
# Render's Environment tab instead of a file.

# Django. Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string (Neon). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# MyAnimeList API app (https://myanimelist.net/apiconfig).
# Its redirect URL must be <FRONTEND_URL>/auth/callback.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Where the React app runs. Used for CORS and the MAL redirect URL.
FRONTEND_URL=http://localhost:5173

# Google Gemini, for the AI chat. Without a key the chat answers 503.
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Set automatically on Render; adds the Render hostname to ALLOWED_HOSTS.
# RENDER_EXTERNAL_HOSTNAME=
